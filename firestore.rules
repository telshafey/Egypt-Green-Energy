rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.email == "elshafey.tamer@gmail.com" ||
          (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
          request.auth.token.firebase.sign_in_provider == 'anonymous' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Site Settings (Public Read for visitors, Admin and Portal Write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Systems / Light Current (Public Read for visitors, Admin and Portal Write)
    match /systems/{systemId} {
      allow read: if true;
      allow write: if true;
    }

    // Projects (Public Read for visitors, Admin and Portal Write)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Technology Brands / Vendors (Public Read for visitors, Admin and Portal Write)
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if true;
    }

    // Media Assets library (Public Read for visitors, Admin and Portal Write)
    match /media_assets/{assetId} {
      allow read: if true;
      allow write: if true;
    }

    // Authorized Admin Users & Team Access Management
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Security & Audit Logs (Admin audit trail)
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Inquiries: Visitors can submit consultation/quote requests; Admin can read & manage
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 200 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() > 0 &&
                       request.resource.data.phone.size() <= 100 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 4000;
      allow read, update, delete: if true;
    }
  }
}
