{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global configuration and customizable content for Egypt Green Energy",
      "type": "object",
      "properties": {
        "companyNameAr": { "type": "string", "maxLength": 100 },
        "companyNameEn": { "type": "string", "maxLength": 100 },
        "taglineAr": { "type": "string", "maxLength": 200 },
        "taglineEn": { "type": "string", "maxLength": 200 },
        "heroTitleAr": { "type": "string", "maxLength": 200 },
        "heroTitleEn": { "type": "string", "maxLength": 200 },
        "heroSubtitleAr": { "type": "string", "maxLength": 500 },
        "heroSubtitleEn": { "type": "string", "maxLength": 500 },
        "heroImageUrl": { "type": "string", "maxLength": 1000 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "phonePrimary": { "type": "string", "maxLength": 50 },
        "phoneSecondary": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "addressAr": { "type": "string", "maxLength": 200 },
        "addressEn": { "type": "string", "maxLength": 200 },
        "whatsappNumber": { "type": "string", "maxLength": 50 },
        "showStats": { "type": "boolean" },
        "showAbout": { "type": "boolean" },
        "showHeritage": { "type": "boolean" },
        "showSystems": { "type": "boolean" },
        "showProjects": { "type": "boolean" },
        "showConfigurator": { "type": "boolean" },
        "showPartners": { "type": "boolean" },
        "showContact": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["companyNameAr", "companyNameEn", "email"]
    },
    "Service": {
      "title": "Service",
      "description": "Light current (ELV) and specialized engineering service",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "titleAr": { "type": "string", "maxLength": 150 },
        "titleEn": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "descriptionAr": { "type": "string", "maxLength": 1000 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "icon": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "order": { "type": "number" },
        "featuresAr": { "type": "array" },
        "featuresEn": { "type": "array" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "titleAr", "titleEn", "descriptionAr"]
    },
    "Project": {
      "title": "Project",
      "description": "Showcase portfolio project executed by the company",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryLabel": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "year": { "type": "string", "maxLength": 20 },
        "clientType": { "type": "string", "maxLength": 100 },
        "sector": { "type": "string", "maxLength": 100 },
        "scopeSummary": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "category"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Technology brand and manufacturer integrated by the company",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "svgContent": { "type": "string", "maxLength": 100000 },
        "websiteUrl": { "type": "string", "maxLength": 300 },
        "descriptionAr": { "type": "string", "maxLength": 500 },
        "descriptionEn": { "type": "string", "maxLength": 500 },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "slug", "category"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Incoming client consultation request or message",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "service": { "type": "string", "maxLength": 100 },
        "facilityType": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 30 }
      },
      "required": ["name", "phone", "message"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrators permitted to access the admin portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "salt": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "lastLogin": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "AuditEvent": {
      "title": "AuditEvent",
      "description": "Security and modification audit log records",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 100 },
        "actorEmail": { "type": "string", "maxLength": 150 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["action", "actorEmail", "timestamp"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global website configuration document"
    },
    "/systems/{systemId}": {
      "schema": "Service",
      "description": "Light current and ELV technology systems"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio of past and present engineering projects"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Technology brands we work with"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Customer inquiries and quotes"
    },
    "/admin_users/{userId}": {
      "schema": "AdminUser",
      "description": "Authorized administrators and control panel users"
    },
    "/audit_logs/{eventId}": {
      "schema": "AuditEvent",
      "description": "Security audit records"
    }
  }
}
